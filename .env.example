# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
# Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon / public key. Supabase now also calls this the "publishable" key
# (sb_publishable_...); either value works here — @supabase/ssr just takes the
# string. Keep the variable name as-is.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Internal identifier for the single shared auth account. The login screen is
# password-only; this email is never rendered.
NEXT_PUBLIC_APP_LOGIN_EMAIL=login@example.com

# --- Listing import (server-only; never NEXT_PUBLIC_) -----------------------

# Anthropic key for the extraction call (claude-haiku-4-5). Without it
# POST /api/import returns 503 { disabled: true } and the panel says so —
# nothing else in the app is affected.
ANTHROPIC_API_KEY=

# Optional. Rung two of the fetch ladder: when a listing site blocks our direct
# fetch, the URL is handed to Firecrawl instead. Leave blank and the ladder just
# drops straight to the paste box, which always works.
# FIRECRAWL_API_KEY=

# --- Photos (server-only; never NEXT_PUBLIC_) ------------------------------

# The service-role key, from Project Settings -> API. It bypasses RLS, so it
# lives only in `src/lib/supabase/admin.ts`, which imports `server-only` —
# an accidental client import is a build error, not a leaked key. Used by
# POST /api/photos to write into the `listing-photos` storage bucket.
# Without it that route answers 500 and nothing else in the app is affected.
SUPABASE_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_SUPABASE_URL (above) is read by the same admin client — the
# storage endpoint is the project URL, so there is no second variable for it.

# --- Listing status sync (server-only; never NEXT_PUBLIC_) -----------------

# Shared secret between Supabase pg_cron and POST /api/sync. Generate one with
#   openssl rand -hex 32
# and put the same value in two places: here (and in Vercel, Production +
# Preview) and in the Supabase Vault as `cron_secret`, which is what the four
# schedules in `supabase/cron.sql.example` send as a bearer token. Without it
# the route refuses every cron call with a 401 — the "Check now" button still
# works, because that path authenticates with the logged-in session instead.
CRON_SECRET=

# The sync also needs SUPABASE_SERVICE_ROLE_KEY (above, shared with the photo
# route) and ANTHROPIC_API_KEY (above, shared with the import). Missing either
# and POST /api/sync answers 503 { disabled: true } and nothing else breaks.

# --- Maps (server-only; never NEXT_PUBLIC_) --------------------------------

# Google Cloud key with the **Routes API** enabled, restricted to that one API.
# Used by POST /api/commutes for walk / bike / transit durations, which is the
# only paid thing in the app — and it is cached in `commute_times` and computed
# once per listing x location x mode, so 60 listings and 5 locations is ~900
# calls total, not per month. Free tier is 10k Essentials calls/month.
#
# Server-only on purpose: the map itself is MapLibre + OpenFreeMap (no key, no
# Google), and the "open in Google Maps" links are keyless deep links. Without
# this variable POST /api/commutes answers 503 { disabled: true }, the commute
# cards show "—", and nothing else in the app notices.
GOOGLE_MAPS_API_KEY=

# Geocoding needs no key at all: NYC GeoSearch (geosearch.planninglabs.nyc)
# with Nominatim as the fallback. POST /api/geocode does need
# SUPABASE_SERVICE_ROLE_KEY (above) to write the pin.
